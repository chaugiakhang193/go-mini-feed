# Copy to .env and adjust. Values below match deployments/docker-compose.yml (local lab only).

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=lab
RABBITMQ_PASSWORD=lab

REDIS_ADDR=localhost:6381
REDIS_PASSWORD=

# IPv4 address of the NIC that joins the multicast groups. Empty = OS default interface.
SERVER_IP_ADDRESS=
